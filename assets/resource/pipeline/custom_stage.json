{
    "CustomStageStart": {
        "recognition": {
            "type": "DirectHit"
        },
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "TkfmCustomStage"
            }
        }
    },
    "CustomStageConfig": {
        "attach": {
            "profile_name": "",
            "profile_id": ""
        }
    },
    "CustomStageScoreConfig": {
        "attach": {
            "enabled": true,
            "limit_thousands": 150,
            "known_score": false
        }
    },
    "__CustomStageScoreText": {
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    0,
                    128,
                    720,
                    128
                ],
                "expected": [
                    "^\\s*[0-9]{1,3}\\s*[,，]\\s*[0-9]{3}\\s*$",
                    "^\\s*[0-9]{1,3}\\s*$"
                ]
            }
        }
    },
    "__CustomStageScoreMultipleSweepCount": {
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [50, 140, 620, 900],
                "expected": ["[扫掃][荡蕩]\\s*(?:[2-9]|[1-9][0-9]+)\\s*次"]
            }
        }
    },
    "CustomStageScoreBefore": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "CustomStageListPage"
                ]
            }
        },
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "TkfmCustomStage",
                "custom_action_param": {
                    "mode": "score",
                    "phase": "before"
                }
            }
        },
        "next": [
            "CustomStageScoreStop",
            "DailyStaminaStartAttempt"
        ],
        "max_hit": 1
    },
    "CustomStageScoreResumeList": {
        "recognition": {
            "type": "And",
            "param": {"all_of": ["CustomStageListPage"]}
        },
        "next": ["CustomStageScoreSelect"]
    },
    "CustomStageScoreSelect": {
        "next": [
            "CustomStageOpenTarget",
            "CustomStageScrollDown",
            "[JumpBack]CommonWaitLoading"
        ],
        "on_error": [
            "CustomStageStageNotFound"
        ]
    },
    "CustomStageScoreAfter": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "CustomStageListPage"
                ]
            }
        },
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "TkfmCustomStage",
                "custom_action_param": {
                    "mode": "score",
                    "phase": "after"
                }
            }
        },
        "next": [
            "CustomStageScoreStop",
            "DailyStaminaReturnMainFromStageList"
        ],
        "max_hit": 1
    },
    "CustomStageScoreAfterRound": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "CustomStageListPage"
                ]
            }
        },
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "TkfmCustomStage",
                "custom_action_param": {
                    "mode": "score",
                    "phase": "round"
                }
            }
        },
        "next": [
            "CustomStageScoreStop",
            "CustomStageScoreContinue",
            "DailyStaminaReturnMainFromStageList"
        ]
    },
    "CustomStageScoreContinue": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "CustomStageListPage",
                    "DailyStaminaPresetStaminaEnough"
                ],
                "box_index": 0
            }
        },
        "next": [
            "CustomStageScoreSelect"
        ]
    },
    "CustomStageScoreStop": {
        "enabled": false,
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "CustomStageListPage"
                ]
            }
        }
    },
    "CustomStageScoreBattleReturn": {
        "enabled": false,
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "__DailyStaminaBattleResultClear",
                    "__DailyStaminaReturnMapButton",
                    "DailyStaminaBattleStaminaEnough"
                ],
                "box_index": 1
            }
        },
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "ClickRecognitionCenter"
            }
        },
        "pre_wait_freezes": {
            "time": 300,
            "target": true,
            "timeout": 1500
        },
        "next": [
            "CustomStageScoreAfterRound",
            "CustomStageScoreBackToList",
            "[JumpBack]CommonWaitLoading"
        ]
    },
    "CustomStageScoreSweepReturn": {
        "enabled": false,
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "__DailyStaminaSweepButton",
                    "CommonReturnMainByBackButton"
                ],
                "box_index": 1
            }
        },
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "ClickRecognitionCenter"
            }
        },
        "pre_wait_freezes": {
            "time": 300,
            "target": true,
            "timeout": 1500
        },
        "next": [
            "CustomStageScoreAfterRound",
            "[JumpBack]CommonWaitLoading"
        ]
    },
    "CustomStageScoreBackToList": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "__DailyStaminaBattleResultButtonsAbsent",
                    "CommonReturnMainByBackButton"
                ],
                "box_index": 1
            }
        },
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "ClickRecognitionCenter"
            }
        },
        "pre_wait_freezes": {
            "time": 300,
            "target": true,
            "timeout": 1500
        },
        "next": [
            "CustomStageScoreAfterRound",
            "[JumpBack]CommonWaitLoading"
        ]
    },
    "CustomStageWithRecovery": {
        "recognition": {
            "type": "DirectHit"
        },
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "TkfmRunWithRecovery",
                "custom_action_param": {
                    "entry": "CustomStageActivityRouter",
                    "label": "自定义关卡",
                    "non_retryable_hit": "CustomStageProgressLocked",
                    "initialize": "DailyAffairsInitialize"
                }
            }
        }
    },
    "CustomStageEntryImage": {
        "enabled": false,
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": [
                    "Common/TopLeftBack720.png"
                ],
                "roi": [
                    0,
                    160,
                    720,
                    1000
                ],
                "threshold": 0.85
            }
        }
    },
    "CustomStageTargetImage": {
        "enabled": false,
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": [
                    "Common/TopLeftBack720.png"
                ],
                "roi": [
                    0,
                    160,
                    720,
                    1000
                ],
                "threshold": 0.85
            }
        }
    },
    "CustomStageListPage": {
        "enabled": false,
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": [
                    "Common/TopLeftBack720.png"
                ],
                "roi": [
                    50,
                    60,
                    600,
                    80
                ],
                "threshold": 0.85
            }
        }
    },
    "CustomStageMainExpedition": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": [
                    "Common/MainExpeditionButton720.png"
                ],
                "roi": [
                    480,
                    820,
                    240,
                    210
                ],
                "threshold": 0.82
            }
        }
    },
    "CustomStageLimitedActivityTab": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": [
                    "Common/LimitedActivityTab720.png"
                ],
                "roi": [
                    460,
                    80,
                    260,
                    100
                ],
                "threshold": 0.82
            }
        }
    },
    "__CustomStageLimitedTabUnderline": {
        "recognition": {
            "type": "ColorMatch",
            "param": {
                "roi": [
                    485,
                    159,
                    140,
                    7
                ],
                "method": 4,
                "lower": [
                    210,
                    200,
                    200
                ],
                "upper": [
                    255,
                    255,
                    255
                ],
                "count": 180,
                "connected": true
            }
        }
    },
    "CustomStageLimitedActivitySelected": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "CustomStageLimitedActivityTab",
                    "__CustomStageLimitedTabUnderline"
                ],
                "box_index": 0
            }
        }
    },
    "CustomStageActivityRouter": {
        "next": [
            "[JumpBack]CommonWaitLoading",
            "CustomStageOpenExpedition",
            "CustomStageOpenEntry",
            "CustomStageOpenLimitedActivities",
            "CustomStageReturnToActivityTab"
        ],
        "timeout": 30000,
        "rate_limit": 1000,
        "max_hit": 30,
        "on_error": [
            "CustomStageNavigationNotFound"
        ]
    },
    "CustomStageOpenExpedition": {
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "TaskCompletionGuard",
                "custom_recognition_param": {
                    "required": [
                        "CustomStageMainExpedition"
                    ],
                    "absent": [
                        "TkfmRecoveryLoginTarget",
                        "TkfmRecoveryReturnTitleTarget",
                        "GameCloseGift",
                        "GameCloseAnnouncement",
                        "GameCloseEventSignIn",
                        "TkfmRecoveryMonthlyCardTarget"
                    ]
                }
            }
        },
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "CustomStageEnterExpedition",
                "custom_action_param": {},
                "target": true
            }
        },
        "pre_wait_freezes": {
            "time": 300,
            "target": true,
            "timeout": 1000
        },
        "post_delay": 600,
        "next": [
            "[JumpBack]CommonWaitLoading",
            "CustomStageActivityRouter"
        ],
        "rate_limit": 1000,
        "max_hit": 6,
        "focus": {
            "Node.Action.Succeeded": "自定义关卡：已点击出征图片中心，继续按当前画面识别活动入口。"
        }
    },
    "CustomStageOpenEntry": {
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "TaskCompletionGuard",
                "custom_recognition_param": {
                    "required": [
                        "CustomStageEntryImage",
                        "CustomStageLimitedActivitySelected"
                    ],
                    "absent": [
                        "TkfmRecoveryLoginTarget",
                        "TkfmRecoveryReturnTitleTarget",
                        "GameCloseGift",
                        "GameCloseAnnouncement",
                        "GameCloseEventSignIn",
                        "TkfmRecoveryMonthlyCardTarget"
                    ]
                }
            }
        },
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "ClickRecognitionCenter",
                "custom_action_param": {},
                "target": true
            }
        },
        "pre_wait_freezes": {
            "time": 300,
            "target": true,
            "timeout": 1000
        },
        "post_delay": 500,
        "next": [
            "CustomStageLimitedListRouter"
        ],
        "rate_limit": 1000,
        "max_hit": 3
    },
    "CustomStageOpenLimitedActivities": {
        "enabled": true,
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "TaskCompletionGuard",
                "custom_recognition_param": {
                    "required": [
                        "CustomStageLimitedActivityTab"
                    ],
                    "absent": [
                        "CustomStageLimitedActivitySelected",
                        "CustomStageListPage",
                        "TkfmRecoveryLoginTarget",
                        "TkfmRecoveryReturnTitleTarget",
                        "GameCloseGift",
                        "GameCloseAnnouncement",
                        "GameCloseEventSignIn",
                        "TkfmRecoveryMonthlyCardTarget"
                    ]
                }
            }
        },
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "ClickRecognitionCenter",
                "custom_action_param": {
                    "hold_ms": 150
                },
                "target": true
            }
        },
        "pre_wait_freezes": {
            "time": 300,
            "target": true,
            "timeout": 1000
        },
        "post_delay": 1000,
        "next": [
            "[JumpBack]CommonWaitLoading",
            "CustomStageActivityRouter"
        ],
        "rate_limit": 1000,
        "max_hit": 3,
        "focus": {
            "Node.Action.Succeeded": "自定义关卡：限时活动尚未选中，已在页签图片中心按压150毫秒；下一轮检查选中标记及活动入口，不以输入成功认定已切页。"
        }
    },
    "CustomStageOpenTarget": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "CustomStageListPage",
                    "CustomStageTargetImage"
                ],
                "box_index": 1
            }
        },
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "ClickRecognitionCenter",
                "custom_action_param": {},
                "target": true
            }
        },
        "pre_wait_freezes": {
            "time": 300,
            "target": true,
            "timeout": 1000
        },
        "post_delay": 500,
        "next": [
            "CustomStageConfirmDetail"
        ],
        "rate_limit": 1000,
        "max_hit": 3
    },
    "CustomStageScrollDown": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "CustomStageListPage"
                ]
            }
        },
        "action": {
            "type": "Swipe",
            "param": {
                "begin": [
                    360,
                    1000
                ],
                "end": [
                    360,
                    450
                ],
                "duration": 500
            }
        },
        "pre_wait_freezes": {
            "time": 300,
            "target": true,
            "timeout": 1000
        },
        "post_delay": 350,
        "next": [
            "CustomStageLimitedListRouter"
        ],
        "rate_limit": 1000,
        "max_hit": 6
    },
    "CustomStageNavigationNotFound": {
        "next": [
            "TkfmTaskFailure"
        ],
        "focus": {
            "Node.Recognition.Succeeded": "自定义关卡：30秒内没有找到仍可执行的导航动作，或该按钮已达到重试上限；请检查当前页面与所选活动、关卡截图。点击已发出不代表页面已经切换。"
        }
    },
    "CustomStageConfirmDetail": {
        "next": [
            "[JumpBack]CommonWaitLoading",
            "CustomStageProgressLocked",
            "CustomStageDetailReady",
            "CustomStageDirectBattleReady"
        ],
        "timeout": 8000,
        "on_error": [
            "CustomStageDetailNotFound"
        ]
    },
    "CustomStageProgressLocked": {
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [90, 595, 550, 65],
                "expected": ["活动进度\\s*需完成.{1,40}后开启"]
            }
        },
        "next": ["TkfmTaskFailure"],
        "timeout": 1,
        "focus": {
            "Node.Recognition.Succeeded": "自定义关卡：目标尚未解锁。请按游戏提示完成前置关卡，或在任务设置中选用已解锁的关卡。"
        }
    },
    "CustomStageDetailReady": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "__DailyStaminaSweepButton"
                ]
            }
        },
        "next": [
            "DailyStaminaStageDetailInitialDecision"
        ]
    },
    "CustomStageEntryNotFound": {
        "next": [
            "TkfmTaskFailure"
        ],
        "focus": {
            "Node.Recognition.Succeeded": "自定义关卡：未找到活动入口图片，请检查配置是否对应目前活动列表；不点击其他活动"
        }
    },
    "CustomStageStageNotFound": {
        "next": [
            "TkfmTaskFailure"
        ],
        "focus": {
            "Node.Recognition.Succeeded": "自定义关卡：关卡未找到、列表页面不匹配或已向下寻找6屏；请检查截图和活动路线"
        }
    },
    "CustomStageDetailNotFound": {
        "next": [
            "TkfmTaskFailure"
        ],
        "focus": {
            "Node.Recognition.Succeeded": "自定义关卡：点击后未确认军团扫荡详情或开始页，请重新设置可进入战斗的关卡截图"
        }
    },
    "CustomStageDirectBattleReady": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "__DailyStaminaTrainingStartButton"
                ]
            }
        },
        "next": [
            "CustomStageDirectBattle"
        ]
    },
    "CustomStageDirectBattle": {
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "TkfmCustomStage",
                "custom_action_param": {
                    "mode": "direct"
                }
            }
        }
    },
    "CustomStageDirectInitial": {
        "next": [
            "[JumpBack]CommonWaitLoading",
            "DailyStaminaRefillWithPotionWhenLow",
            "DailyStaminaRefillWithCurrencyWhenLow",
            "DailyStaminaTrainingFinishWhenLow",
            "DailyStaminaTrainingStart"
        ],
        "timeout": 8000,
        "on_error": [
            "CustomStageDetailNotFound"
        ]
    },
    "CustomStageLimitedListRouter": {
        "next": [
            "[JumpBack]CommonWaitLoading",
            "CustomStageOpenExpedition",
            "CustomStageScoreBefore",
            "CustomStageOpenTarget",
            "CustomStageOpenEntry",
            "CustomStageOpenLimitedActivities",
            "CustomStageScrollDown"
        ],
        "timeout": 30000,
        "rate_limit": 1000,
        "max_hit": 30,
        "on_error": [
            "CustomStageNavigationNotFound"
        ]
    },
    "__CustomStageListBack": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "Common/TopLeftBack720.png",
                "roi": [
                    0,
                    45,
                    125,
                    60
                ],
                "threshold": 0.85
            }
        }
    },
    "CustomStageReturnToActivityTab": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "CustomStageListPage",
                    "__CustomStageListBack"
                ],
                "box_index": 1
            }
        },
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "ClickRecognitionCenter",
                "custom_action_param": {},
                "target": true
            }
        },
        "pre_wait_freezes": {
            "time": 300,
            "target": true,
            "timeout": 1000
        },
        "next": [
            "CustomStageActivityRouter"
        ],
        "max_hit": 3
    }
}
