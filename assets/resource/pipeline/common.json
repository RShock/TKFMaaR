{
    "__CommonMainExpeditionButton": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": [
                    "Common/MainExpeditionButton720.png"
                ],
                "roi": [
                    480,
                    820,
                    240,
                    210
                ],
                "threshold": 0.9,
                "method": 10001
            }
        }
    },
    "__CommonMainTrainingButton": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": [
                    "Common/MainTrainingButton720.png"
                ],
                "roi": [
                    570,
                    1000,
                    135,
                    110
                ],
                "threshold": 0.9,
                "method": 10001
            }
        }
    },
    "CommonMainReady": {
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "TaskCompletionGuard",
                "custom_recognition_param": {
                    "required": [
                        "__CommonMainExpeditionButton",
                        "__CommonMainTrainingButton"
                    ],
                    "absent": [
                        "TkfmRecoveryReturnTitleTarget",
                        "TkfmRecoverySessionExpiredTarget",
                        "TkfmRecoveryBackButtonTarget",
                        "GameCloseGift",
                        "GameCloseAnnouncement",
                        "GameCloseEventSignIn",
                        "TkfmRecoveryMonthlyCardTarget",
                        "TkfmRecoveryExitGameTarget"
                    ]
                }
            }
        }
    },
    "CommonStopOnMain": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "CommonMainReady"
                ]
            }
        },
        "action": {
            "type": "StopTask"
        }
    },
    "CommonStopOnMainWithRetries": {
        "next": [
            "[JumpBack]CommonWaitLoading",
            "[JumpBack]CommonCloseMainGift",
            "CommonStopOnMainObserve",
            "CommonStopOnMainWait1"
        ],
        "timeout": 10000
    },
    "CommonStopOnMainWait1": {
        "recognition": {
            "type": "DirectHit"
        },
        "next": [
            "[JumpBack]CommonWaitLoading",
            "[JumpBack]CommonCloseMainGift",
            "CommonStopOnMainObserve",
            "CommonStopOnMainWait2"
        ],
        "timeout": 10000,
        "post_delay": 300
    },
    "CommonStopOnMainWait2": {
        "recognition": {
            "type": "DirectHit"
        },
        "next": [
            "[JumpBack]CommonWaitLoading",
            "[JumpBack]CommonCloseMainGift",
            "CommonStopOnMainObserve",
            "CommonStopOnMainWait3"
        ],
        "timeout": 10000,
        "post_delay": 300
    },
    "CommonStopOnMainWait3": {
        "recognition": {
            "type": "DirectHit"
        },
        "next": [
            "[JumpBack]CommonWaitLoading",
            "[JumpBack]CommonCloseMainGift",
            "CommonStopOnMain"
        ],
        "timeout": 10000,
        "post_delay": 300
    },
    "CommonStopOnMainObserve": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "CommonMainReady"
                ]
            }
        },
        "next": [
            "CommonStopOnMainConfirm"
        ],
        "post_delay": 1000
    },
    "CommonStopOnMainConfirm": {
        "next": [
            "[JumpBack]CommonWaitLoading",
            "[JumpBack]CommonCloseMainGift",
            "CommonStopOnMain"
        ],
        "timeout": 10000
    },
    "CommonWaitLoading": {
        "recognition": {
            "type": "OCR",
            "param": {
                "expected": [
                    "[Ll]\\s*[Oo0]\\s*[Aa]\\s*[Dd]",
                    "[Cc]?\\s*[Oo0]\\s*[Nn]\\s*[Nn]?\\s*[Ee]\\s*[CcGg]"
                ],
                "roi": [
                    180,
                    1158,
                    360,
                    92
                ]
            }
        },
        "post_delay": 500
    },
    "CommonCloseReward": {
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    300,
                    700,
                    120,
                    80
                ],
                "expected": [
                    "确定",
                    "确认"
                ]
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": true
            }
        },
        "pre_wait_freezes": {
            "time": 300,
            "target": [
                300,
                700,
                120,
                80
            ],
            "timeout": 1500
        }
    },
    "__CommonGiftTabs": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "GameCloseGift"
                ]
            }
        }
    },
    "CommonCloseMainGift": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "GameCloseGift"
                ]
            }
        },
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "ClickRecognitionCenter",
                "custom_action_param": {}
            }
        },
        "pre_wait_freezes": {
            "time": 300,
            "timeout": 1500,
            "target": true
        },
        "max_hit": 3
    }
}
