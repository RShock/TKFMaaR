    "__TkfmRecoverySessionExpiredReasonText": {
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    85,
                    565,
                    550,
                    115
                ],
                "threshold": 0.3,
                "expected": [
                    "日期.*(?:变更|變更|更新)",
                    "(?:服务器|伺服器).*(?:异常|異常|错误|錯誤|维护|維護|断|斷)",
                    "(?:连线|連線|连接|連接|登入|登录|登錄).*(?:失败|失敗|异常|異常|错误|錯誤|逾时|逾時|超时|超時)",
                    "(?:重新|回到|返回).*(?:登入|登录|登錄|标题|標題)",
                    "(?:网络|網路|網絡).*(?:不稳|不穩|异常|異常|断|斷|错误|錯誤)",
                    "重新(?:启动|啟動|啓動)(?:游戏|遊戲)"
                ]
            }
        }
    },
    "TkfmRecoverySessionExpiredTarget": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "TkfmRecoverySessionExpiredTitle",
                    "TkfmRecoverySessionExpiredButton",
                    "TkfmRecoverySessionExpiredReason"
