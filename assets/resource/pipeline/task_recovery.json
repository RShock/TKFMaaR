        "pre_wait_freezes": {"time": 300, "target": true, "timeout": 1500},
        "post_delay": 500,
        "max_hit": 2,
        "focus": {
            "Node.Action.Starting": "异常恢复：同帧识别到“是否要回到标题画面？”和“取消”图片，点击取消按钮中心，保留当前游戏页面后继续原任务；不点击确定，不发送系统返回（共享最多两次）。"
        }
